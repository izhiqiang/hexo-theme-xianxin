<div class="contar-wrap">
    <div class="item-box">
        <!-- tag开始-->
        <% if (site.tags && site.tags.length > 0) { %>
            <div class="post-meta">
                <% site.tags.forEach(function(tags) { %> 
                    <a href="<%= url_for(tags.path) %>">
                        <button type="button" class="layui-btn layui-btn-sm" style="
                            position: relative;
                            width: 120px;
                            height: 30px;
                            margin: 5px;
                            border: none;
                            border-radius: 20px;
                            color: white;
                            font-weight: bold;
                            background: linear-gradient(45deg, #1e9fff 0%, #007bff 100%);
                            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
                            cursor: pointer;
                            overflow: hidden;
                            transition: all 0.3s ease;
                        ">
                            <span style="position: relative; z-index: 2;">#<%= tags.name %></span>
                            <span style="
                                position: absolute;
                                top: 0;
                                left: 0;
                                width: 100%;
                                height: 100%;
                                background: rgba(255, 255, 255, 0.2);
                                transform: translateX(-100%) skewX(-20deg);
                                transition: transform 0.5s ease;
                            "></span>
                        </button>
                    </a>
                <% }); %>
            </div>
        <% } %>
    </div>
</div>